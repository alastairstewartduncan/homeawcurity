<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is allowed because the recorder on your home network may not have a certificate.
     Use https when reaching it from outside the house. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
